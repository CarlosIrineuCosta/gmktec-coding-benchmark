# Generated evidence, hidden task material, and provider state are never
# published directly. They belong under the explicit private-data boundary.
data/private/

# Durable local benchmark archives. These preserve reproducible experiment
# waypoints while keeping fixtures, generated artifacts, and provider-adjacent
# evidence out of the public repository.
.local/experiments/

# Common secret and runtime formats.
.env
.env.*
*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Python and test caches.
*.pyc
__pycache__/
.pytest_cache/

# Build products.
build/
dist/
*.egg-info/
