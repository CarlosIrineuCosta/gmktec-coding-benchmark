{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama_gmktec": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen3-Coder 30B via local llama-server",
      "options": {
        "baseURL": "http://127.0.0.1:8081/v1",
        "apiKey": "local"
      },
      "models": {
        "qwen3-coder-30b": {
          "name": "Qwen3-Coder 30B",
          "limit": { "context": 65536, "output": 1024 }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "skill": "deny",
    "lsp": "deny",
    "question": "deny",
    "doom_loop": "deny"
  }
}
