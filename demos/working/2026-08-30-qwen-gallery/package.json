{
  "name": "evaluation-gallery-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:contract": "playwright test",
    "test:verify": "playwright test --config playwright.validate.config.ts",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
